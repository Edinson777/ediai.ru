---
/**
 * Базовый каркас страницы — порт head_html() + тело из build.py, дополненный
 * шапкой из 5 пунктов и хлебными крошками (стратегия §4.1–4.3, фаза 2).
 * Рендерит <html>/<head> (SEO, OG, JSON-LD, инлайн CSS) и <body> со счётчиками.
 * Содержимое страницы — через <slot/>; футеры собираются на страницах.
 *
 * path — абсолютный путь страницы ('/prompty/foto/', '/guides/…', '/' для главной).
 * crumb — массив {name, href?} для хлебных крошек (последний элемент — без ссылки);
 *         на главной не передаётся. BreadcrumbList JSON-LD собирает сама страница.
 */
import { SITE_NAME, SITE_URL, CSS, FAVICON, METRIKA, gtagSnippet, adsSnippet,
         D, TOTAL, SECTION_ORDER, SECTION_PATHS, SECTION_LABELS, GUIDES } from '../lib/site.js';
import { attr } from '../lib/gen.js';
import chromeCss from '../styles/chrome.css?raw';

const {
  title,
  desc,
  path,          // '/prompty/foto/' | '/' | …
  ogImg,         // 'og/og-photo.png'
  ldGraph,       // готовая ld()-строка JSON-LD
  ogType = 'website',
  crumb = null,  // хлебные крошки [{name, href?}] или null (главная)
  chrome = true,   // false → без шапки Base (новые страницы редизайна со своей шапкой)
  themeColor = '#f5f6fa', // цвет темы браузера (новые страницы — #f3f0e8)
  extraCss = null, // CSS-строка новых страниц, инлайнится ПОСЛЕ chrome.css
  bodyClass = '',  // класс корневого body (новые страницы — e-body)
  baseCss = true,  // false → не подключать старые style.css/chrome.css (новые страницы несут только свой CSS)
} = Astro.props;

const url = SITE_URL + path;
const curPath = path.replace(/\/+$/, '') || '/';

// активный пункт меню: текущая страница начинается с пути пункта
function isActive(href) {
  const h = href.replace(/\/+$/, '') || '/';
  if (h === '/') return curPath === '/';
  return curPath === h || curPath.startsWith(h + '/');
}

// в дропдауне и мобильном аккордеоне — только 6 промpty-категорий;
// basics адресуется в /guides/ и уже есть в подменю «Гайды» (§3.3)
const promptItems = SECTION_ORDER.filter(k => k !== 'basics').map(key => ({
  href: SECTION_PATHS[key], label: SECTION_LABELS[key], n: D.BY_SECTION_COUNTS[key],
}));

const toolsItems = [
  { href: '/prompty/qwen/', label: 'Qwen', note: 'промпты и подсказки совместимости' },
  { href: '/guides/kakuyu-nejroset-vybrat/', label: 'ChatGPT', note: 'страницы моделей — в разработке' },
  { href: '/prompty/generaciya/', label: 'Midjourney', note: 'промпты генерации изображений' },
  { href: '/guides/kakuyu-nejroset-vybrat/', label: 'GigaChat', note: 'сравнение моделей' },
  { href: '/guides/kakuyu-nejroset-vybrat/', label: 'YandexGPT', note: 'сравнение моделей' },
];

// мобильный аккордеон: те же пункты, разделы с подразделами раскрываются
const mobilePrompts = promptItems;
const mobileGuides = GUIDES.map(g => ({ href: g.path, label: g.label }));
---

<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={attr(desc)}>
<link rel="canonical" href={url}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content={attr(SITE_NAME)}>
<meta property="og:title" content={attr(title)}>
<meta property="og:description" content={attr(desc)}>
<meta property="og:url" content={url}>
<meta property="og:image" content={SITE_URL + '/' + ogImg}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="ru_RU">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={attr(title)}>
<meta name="twitter:description" content={attr(desc)}>
<meta name="twitter:image" content={SITE_URL + '/' + ogImg}>
<meta name="theme-color" content={themeColor}>
<link rel="icon" href={FAVICON}>
<link rel="icon" type="image/x-icon" href={SITE_URL + '/favicon.ico'} sizes="16x16 32x32 48x48">
<link rel="apple-touch-icon" href={SITE_URL + '/apple-touch-icon.png'}>
<link rel="alternate" type="application/rss+xml" title="Ediai — гайды и сценарии" href={SITE_URL + '/rss.xml'}>
<script type="application/ld+json" is:inline set:html={ldGraph} />
{baseCss && <style is:inline set:html={CSS} />}
{baseCss && <style is:inline set:html={chromeCss} />}
{extraCss && <style is:inline set:html={extraCss} />}
</head>
<body class={bodyClass}>
<Fragment set:html={METRIKA} />
<Fragment set:html={gtagSnippet()} />
<a class="skip-link" href="#main">Перейти к содержимому</a>
{chrome && (
<header class="site-header">
  <div class="wrap sh-in">
    <a class="sh-logo" href="/" aria-label="Ediai — на главную">⚡ <span>Ediai<span class="sh-logo-d">.ru</span></span></a>
    <nav class="sh-nav" aria-label="Главное меню">
      <div class:list={['sh-item', { 'has-drop': true, 'active': isActive('/prompty/') }]}>
        <a class="sh-link" href="/prompty/">Промпты</a>
        <button type="button" class="sh-toggle" aria-expanded="false" aria-label="Подменю «Промпты»">▾</button>
        <div class="sh-drop">
          <div class="sh-col">
            <p class="sh-col-t">Категории</p>
            {promptItems.map(it => (
              <a class="sh-row" href={it.href}>
                <span>{it.label}</span><span class="sh-n">{it.n}</span>
              </a>
            ))}
          </div>
          <div class="sh-col">
            <p class="sh-col-t">Сценарии</p>
            <p class="sh-soon">Готовятся: «Нейрофотосессия», «Промпты по профессиям», «ИИ и почта» — сценарные подборки с примерами до/после.</p>
            <p class="sh-col-t">Материалы</p>
            <a class="sh-row" href="/guides/ii-i-pochta/"><span>Кейс: сколько часов экономит ИИ на почте</span></a>
            <a class="sh-row" href="/guides/s-chego-nachat/"><span>Первая неделя с ИИ</span></a>
          </div>
          <a class="sh-card" href="/prompty/">
            <b>Вся база — {TOTAL} промптов</b>
            <span>Карта раздела: все категории, сценарии и материалы в одном месте</span>
            <span class="sh-go">Открыть →</span>
          </a>
        </div>
      </div>
      <div class:list={['sh-item', { 'has-drop': true, 'active': isActive('/guides/') }]}>
        <a class="sh-link" href="/guides/">Гайды</a>
        <button type="button" class="sh-toggle" aria-expanded="false" aria-label="Подменю «Гайды»">▾</button>
        <div class="sh-drop">
          <div class="sh-col">
            {mobileGuides.map(it => (
              <a class="sh-row" href={it.href}><span>{it.label}</span></a>
            ))}
          </div>
        </div>
      </div>
      <div class:list={['sh-item', { 'has-drop': true, 'active': isActive('/instrumenty/') }]}>
        <a class="sh-link" href="/instrumenty/">Инструменты</a>
        <button type="button" class="sh-toggle" aria-expanded="false" aria-label="Подменю «Инструменты»">▾</button>
        <div class="sh-drop">
          <div class="sh-col">
            {toolsItems.map(it => (
              <a class="sh-row" href={it.href}><span>{it.label}</span><span class="sh-note">{it.note}</span></a>
            ))}
          </div>
        </div>
      </div>
      <div class:list={['sh-item', { 'active': isActive('/glossary/') }]}>
        <a class="sh-link" href="/glossary/">Глоссарий</a>
      </div>
      <div class:list={['sh-item', { 'active': isActive('/o-proekte/') }]}>
        <a class="sh-link" href="/o-proekte/">О проекте</a>
      </div>
    </nav>
    <form class="sh-search" action="/" method="get" role="search">
      <input type="search" name="q" placeholder={'Поиск по ' + TOTAL + ' промптам…'} aria-label="Поиск по сайту" autocomplete="off">
    </form>
    <button type="button" class="sh-burger" aria-expanded="false" aria-controls="shMobile" aria-label="Открыть меню">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="sh-mobile" id="shMobile" hidden>
    <form class="sh-msearch" action="/" method="get" role="search">
      <input type="search" name="q" placeholder={'Поиск по ' + TOTAL + ' промптам…'} aria-label="Поиск по сайту" autocomplete="off">
    </form>
    <div class="sh-macc" data-macc>
      <button type="button" class="sh-mhead" aria-expanded="false">Промпты <span class="sh-mn">{TOTAL}</span></button>
      <div class="sh-mbody" hidden>
        <a href="/prompty/">Карта промптов</a>
        {mobilePrompts.map(it => (
          <a href={it.href}>{it.label} <span class="sh-mn">{it.n}</span></a>
        ))}
      </div>
    </div>
    <div class="sh-macc" data-macc>
      <button type="button" class="sh-mhead" aria-expanded="false">Гайды</button>
      <div class="sh-mbody" hidden>
        <a href="/guides/">Все гайды</a>
        {mobileGuides.map(it => (
          <a href={it.href}>{it.label}</a>
        ))}
      </div>
    </div>
    <div class="sh-macc" data-macc>
      <button type="button" class="sh-mhead" aria-expanded="false">Инструменты</button>
      <div class="sh-mbody" hidden>
        <a href="/instrumenty/">Обзор моделей</a>
        <a href="/prompty/qwen/">Qwen</a>
        <a href="/guides/kakuyu-nejroset-vybrat/">Какую нейросеть выбрать</a>
      </div>
    </div>
    <a class="sh-mlink" href="/glossary/">Глоссарий</a>
    <a class="sh-mlink" href="/o-proekte/">О проекте</a>
    <a class="sh-mlink" href="/poisk/">Поиск по сайту</a>
  </div>
</header>
)}
{chrome && crumb && (
<nav class="crumbs wrap" aria-label="Хлебные крошки">
  <ol>
    {crumb.map((c, i) => (
      <li>
        {i > 0 && <span class="cr-sep" aria-hidden="true">→</span>}
        {c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
)}
<slot />
<Fragment set:html={adsSnippet()} />
<script is:inline>
(function(){
"use strict";
/* Шапка: дропдауны по клику (тач/клавиатура), наведение — через CSS; мобильный аккордеон. */
var burger = document.querySelector('.sh-burger');
var panel  = document.getElementById('shMobile');
if (burger && panel) {
  burger.addEventListener('click', function(){
    var open = panel.hidden;
    panel.hidden = !open;
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    burger.classList.toggle('open', open);
  });
}
document.querySelectorAll('.sh-item.has-drop').forEach(function(item){
  var btn = item.querySelector('.sh-toggle');
  if (!btn) return;
  btn.addEventListener('click', function(e){
    e.stopPropagation();
    var open = item.classList.toggle('drop-open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.querySelectorAll('.sh-item.drop-open').forEach(function(o){
      if (o !== item) { o.classList.remove('drop-open');
        var b = o.querySelector('.sh-toggle'); if (b) b.setAttribute('aria-expanded','false'); }
    });
  });
});
document.addEventListener('click', function(e){
  if (!e.target.closest('.sh-item.has-drop')) {
    document.querySelectorAll('.sh-item.drop-open').forEach(function(o){
      o.classList.remove('drop-open');
      var b = o.querySelector('.sh-toggle'); if (b) b.setAttribute('aria-expanded','false');
    });
  }
});
document.addEventListener('keydown', function(e){
  if (e.key === 'Escape') {
    document.querySelectorAll('.sh-item.drop-open').forEach(function(o){
      o.classList.remove('drop-open');
      var b = o.querySelector('.sh-toggle'); if (b) b.setAttribute('aria-expanded','false');
    });
    if (burger && !panel.hidden) burger.click();
  }
});
document.querySelectorAll('[data-macc] .sh-mhead').forEach(function(head){
  head.addEventListener('click', function(){
    var body = head.nextElementSibling;
    var open = body.hidden;
    body.hidden = !open;
    head.setAttribute('aria-expanded', open ? 'true' : 'false');
    head.classList.toggle('open', open);
  });
});
})();
</script>
</body>
</html>
