---
/**
 * Базовый каркас страницы — порт head_html() + тело из build.py, дополненный
 * шапкой из 5 пунктов и хлебными крошками (стратегия §4.1–4.3, фаза 2).
 * Рендерит <html>/<head> (SEO, OG, JSON-LD, инлайн CSS) и <body> со счётчиками.
 * Содержимое страницы — через <slot/>; футеры собираются на страницах.
 *
 * path — абсолютный путь страницы ('/prompty/foto/', '/guides/…', '/' для главной).
 * crumb — массив {name, href?} для хлебных крошек (последний элемент — без ссылки);
 *         на главной не передаётся. BreadcrumbList JSON-LD собирает сама страница.
 */
import { SITE_NAME, SITE_URL, CSS, FAVICON, METRIKA, gtagSnippet, adsSnippet } from '../lib/site.js';
import { attr } from '../lib/gen.js';
import tokensCss from '../styles/tokens.css?raw';
import newpagesCss from '../styles/newpages.css?raw';

const {
  title,
  desc,
  path,          // '/prompty/foto/' | '/' | …
  ogImg,         // 'og/og-photo.png'
  ldGraph,       // готовая ld()-строка JSON-LD
  ogType = 'website',
  crumb = null,  // хлебные крошки [{name, href?}] или null (главная)
  chrome = true,   // false → без шапки Base (новые страницы редизайна со своей шапкой)
  themeColor = '#f3f0e8', // цвет темы браузера (новые страницы — #f3f0e8)
  extraCss = null, // CSS-строка новых страниц, инлайнится ПОСЛЕ chrome.css
  bodyClass = '',  // класс корневого body (новые страницы — e-body)
  baseCss = true,  // false → не подключать старые style.css/chrome.css (новые страницы несут только свой CSS)
} = Astro.props;

const url = SITE_URL + path;
const curPath = path.replace(/\/+$/, '') || '/';

/* Мост новой шапки/футера под контейнер старых страниц (.wrap = 1200px + 20px):
   выравнивает e-head и футер по сетке старого контента и сбрасывает
   старые элементные правила тега footer (border/text-align/цвет). */
const bridgeCss = `
.e-head{width:min(1200px,calc(100% - 56px));padding:0 20px}
.nh-footer .e-wrap{width:min(1200px,calc(100% - 56px));padding:0 20px}
.nh-footer{border-top:0;text-align:left;font-size:16px;line-height:1.45;color:var(--ink)}
@media(max-width:700px){
  .e-head{width:calc(100% - 32px);padding:0 16px}
  .nh-footer .e-wrap{width:calc(100% - 32px);padding:0 16px}
}`;
---

<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={attr(desc)}>
<link rel="canonical" href={url}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content={attr(SITE_NAME)}>
<meta property="og:title" content={attr(title)}>
<meta property="og:description" content={attr(desc)}>
<meta property="og:url" content={url}>
<meta property="og:image" content={SITE_URL + '/' + ogImg}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="ru_RU">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={attr(title)}>
<meta name="twitter:description" content={attr(desc)}>
<meta name="twitter:image" content={SITE_URL + '/' + ogImg}>
<meta name="theme-color" content={themeColor}>
<link rel="icon" href={FAVICON}>
<link rel="icon" type="image/x-icon" href={SITE_URL + '/favicon.ico'} sizes="16x16 32x32 48x48">
<link rel="apple-touch-icon" href={SITE_URL + '/apple-touch-icon.png'}>
<link rel="alternate" type="application/rss+xml" title="Ediai — гайды и сценарии" href={SITE_URL + '/rss.xml'}>
<script type="application/ld+json" is:inline set:html={ldGraph} />
{baseCss && <style is:inline set:html={tokensCss} />}
{baseCss && <style is:inline set:html={CSS} />}
{baseCss && <style is:inline set:html={newpagesCss + bridgeCss} />}
{extraCss && <style is:inline set:html={extraCss} />}
</head>
<body class={bodyClass}>
<Fragment set:html={METRIKA} />
<Fragment set:html={gtagSnippet()} />
<a class="skip-link" href="#main">Перейти к содержимому</a>
{chrome && (
<header class="e-head">
  <a class="brand" href="/" aria-label="EDIAI — на главную"><span class="brand-symbol">E.</span><span><span class="brand-word">EDIAI</span><span class="brand-sub">разумнее с деньгами · увереннее с технологиями</span></span></a>
  <nav class="e-nav" aria-label="Главное меню">
    <a href="/finansy/">Финансы</a>
    <a href="/prompty/">ИИ</a>
    <a href="/digital/">Цифровая жизнь</a>
    <a href="/instrumenty/">Инструменты</a>
  </nav>
  <a class="btn btn-dark e-cta" href="/guides/s-chego-nachat/">Найти полезное ↗</a>
</header>
)}
{chrome && crumb && (
<div class="wrap">
  <nav class="e-crumbs" aria-label="Хлебные крошки">
    <ol>
      {crumb.map((c) => (
        <li>
          {c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
        </li>
      ))}
    </ol>
  </nav>
</div>
)}
<slot />
{chrome && (
<footer class="nh-footer"><div class="e-wrap"><div class="footer-top"><div class="footer-brand"><a class="brand" href="/"><span class="brand-symbol">E.</span><span><span class="brand-word">EDIAI</span><span class="brand-sub">разумнее с деньгами · увереннее с технологиями</span></span></a><p>Практический портал о финансах, искусственном интеллекте и цифровой жизни. Понятно о сложном — полезно в повседневных решениях.</p></div><div><h4>Направления</h4><div class="footer-links"><a href="/finansy/">Финансы</a><a href="/prompty/">Искусственный интеллект</a><a href="/digital/">Цифровая жизнь</a><a href="/instrumenty/">Инструменты</a></div></div><div><h4>EDIAI</h4><div class="footer-links"><a href="/guides/s-chego-nachat/">С чего начать</a><a href="/guides/">Материалы</a><a href="/glossary/">Глоссарий</a><a href="/o-proekte/">О проекте</a><a href="/poisk/">Поиск</a></div></div></div><div class="footer-bottom"><span>© {SITE_NAME} · ediai.ru</span><span>Материалы о финансах носят информационный характер и не являются инвестиционной рекомендацией.</span></div></div></footer>
)}
<Fragment set:html={adsSnippet()} />
</body>
</html>
