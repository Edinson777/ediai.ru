---
/** Хаб «Финансы» — новый слой редизайна (этап 1). Минимальный набор: 3 стартовых
 *  материала, принципы раздела, ИИ-помощники для денег (мостик к базе промптов), FAQ. */
import Article from '../../layouts/Article.astro';
import { SITE_URL } from '../../lib/site.js';
import { ld } from '../../lib/gen.js';
import dataJson from '../../vendor/data.json';

const p135 = dataJson.prompts.find(p => p.id === 'p135');
const p134 = dataJson.prompts.find(p => p.id === 'p134');

const title = 'Финансы — как сохранять, накапливать и разумно использовать деньги | EDIAI';
const desc = 'Понятные материалы о деньгах: ИИС-3 и налоговые льготы, ПДС, вклады и накопительные счета, подушка безопасности. Без обещаний доходности — с ссылками на официальные источники.';

const crumb = [
  { name: 'Главная', href: '/' },
  { name: 'Финансы' },
];

const ldGraphObj = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: crumb.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name,
      ...(c.href ? { item: SITE_URL + c.href } : {}) })) },
  { '@type': 'CollectionPage', '@id': SITE_URL + '/finansy/', url: SITE_URL + '/finansy/',
    name: 'Финансы', description: desc, inLanguage: 'ru',
    isPartOf: { '@id': SITE_URL + '/#website' } },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'С чего начать, если раньше не занимался финансами?',
      acceptedAnswer: { '@type': 'Answer', text: 'Начните с трёх шагов: посчитайте доходы и расходы за месяц, соберите подушку безопасности на 3–6 месяцев жизни и только потом разбирайтесь с инструментами вроде ИИС-3 и ПДС. Каждый материал раздела начинается с простого объяснения и чек-листа действий.' } },
    { '@type': 'Question', name: 'Материалы раздела — это инвестиционные рекомендации?',
      acceptedAnswer: { '@type': 'Answer', text: 'Нет. EDIAI объясняет, как устроены инструменты и на что обратить внимание, но не советует, куда вложить ваши деньги. Условия каждого продукта проверяйте по официальным источникам — сайту Банка России, ФНС и документам самого продукта.' } },
    { '@type': 'Question', name: 'Чем помогёт искусственный интеллект в личных финансах?',
      acceptedAnswer: { '@type': 'Answer', text: 'Нейросеть поможет посчитать сценарии накоплений, разобрать выписку по карте и подготовиться к разговору с финансовым советником. Готовые запросы — в разделе «ИИ в личной жизни», а в материале «ИИС-3» есть запрос для сравнения условий у разных брокеров.' } },
  ] },
] };
---

<Article title={title} desc={desc} path="/finansy/" ogImg="og/og-finansy.png"
          ldGraph={ld(ldGraphObj)} hero="finansy"
          eyebrow="Направление EDIAI / 01 · Деньги и будущее"
          crumb={crumb}>
<Fragment slot="hero">
  <h1>Финансы. Спокойствие начинается с&nbsp;ясности.</h1>
  <p class="nh-lead">Как сохранять, накапливать и разумно использовать деньги: объясняем условия простыми словами, сравниваем варианты и показываем, на что обратить внимание перед решением.</p>
</Fragment>

<section class="e-section" style="padding-top:0"><div class="e-wrap">
  <div class="e-eyebrow"><span class="e-dot"></span>С чего начать</div>
  <h2 class="e-h2">Первые три материала</h2>
  <p class="e-sub">Каждый материал — это простое объяснение, чек-лист действий и ссылки на официальные источники.</p>
  <div class="e-grid" style="margin-top:20px">
    <a class="e-card" href="/finansy/podushka-bezopasnosti/"><span class="tag">Шаг 1 · Безопасность</span><h3>Подушка безопасности: сколько и где держать</h3><p>Сколько денег нужно на «чёрный день», где их хранить и почему нельзя смешивать запас с накоплениями на цели.</p><span class="go">ЧИТАТЬ ↗</span></a>
    <a class="e-card" href="/finansy/pds-vklad-nakopitelnyj-schet/"><span class="tag">Шаг 2 · Выбор места</span><h3>ПДС, вклад или накопительный счёт</h3><p>Сравниваем три места для денег: доступ, доходность, господдержка и риски — таблицей и простыми словами.</p><span class="go">ЧИТАТЬ ↗</span></a>
    <a class="e-card" href="/finansy/iis-3-nalogovye-lgoty/"><span class="tag">Шаг 3 · Долгий горизонт</span><h3>ИИС-3: льготы и что проверить перед открытием</h3><p>Две налоговые льготы сразу, минимальный срок владения и типичные ошибки новичков.</p><span class="go">ЧИТАТЬ ↗</span></a>
  </div>
</div></section>

<section class="e-section" style="padding-top:0"><div class="e-wrap">
  <div class="e-eyebrow">Как мы готовим материалы</div>
  <h2 class="e-h2">Принципы раздела</h2>
  <ul class="e-list">
    <li><b>Официальные источники.</b> <span>Ставки, лимиты и условия — из материалов Банка России, ФНС и самих продуктов; ссылка есть в каждом материале.</span></li>
    <li><b>Без обещаний доходности.</b> <span>Цифры в примерах условные и помечены так; материал не заменяет консультацию специалиста.</span></li>
    <li><b>Дата актуальности.</b> <span>Материалы со ставками и лимитами помечены датой и пересматриваются раз в квартал.</span></li>
    <li><b>Спокойный тон.</b> <span>Без паники, «инвестиций мечты» и продажи курсов — только понятные объяснения и чек-листы.</span></li>
  </ul>
</div></section>

<section class="e-section" style="padding-top:0"><div class="e-wrap">
  <div class="e-eyebrow">ИИ × Деньги</div>
  <h2 class="e-h2">ИИ-помощники для денег</h2>
  <p class="e-sub">Готовые запросы для нейросетей из нашей базы — скопируйте, подставьте свои цифры и уточняйте ответ по ходу.</p>
  <div class="e-grid" style="margin-top:20px">
    <a class="e-card lav" href={'/prompty/zhizn/?q=' + encodeURIComponent(p135.title)}><span class="tag">Запрос · Планирование</span><h3>{p135.title}</h3><p>{p135.desc}</p><span class="go">ОТКРЫТЬ ЗАПРОС ↗</span></a>
    <a class="e-card lav" href={'/prompty/zhizn/?q=' + encodeURIComponent(p134.title)}><span class="tag">Запрос · Разбор</span><h3>{p134.title}</h3><p>{p134.desc}</p><span class="go">ОТКРЫТЬ ЗАПРОС ↗</span></a>
    <a class="e-card" href="/prompty/zhizn/"><span class="tag">База промптов</span><h3>Все сценарии «ИИ в личной жизни»</h3><p>56 проверенных запросов: быт, здоровье, путешествия, обучение и финансы.</p><span class="go">ОТКРЫТЬ РАЗДЕЛ ↗</span></a>
  </div>
</div></section>

<section class="e-section" style="padding-top:0"><div class="e-wrap">
  <div class="e-eyebrow">Частые вопросы</div>
  <h2 class="e-h2">Спрашивают перед стартом</h2>
  <div class="e-faq">
    <details><summary>С чего начать, если раньше не занимался финансами?</summary><p>С трёх шагов: посчитайте доходы и расходы за месяц, соберите подушку безопасности на 3–6 месяцев жизни и только потом разбирайтесь с инструментами вроде ИИС-3 и ПДС. Каждый материал раздела начинается с простого объяснения и чек-листа.</p></details>
    <details><summary>Материалы раздела — это инвестиционные рекомендации?</summary><p>Нет. EDIAI объясняет, как устроены инструменты и на что обратить внимание, но не советует, куда вложить ваши деньги. Условия каждого продукта проверяйте по официальным источникам — сайту Банка России, ФНС и документам самого продукта.</p></details>
    <details><summary>Чем поможет искусственный интеллект в личных финансах?</summary><p>Нейросеть посчитает сценарии накоплений, разберёт выписку по карте и поможет подготовиться к разговору с советником. Готовые запросы — выше и в разделе «ИИ в личной жизни».</p></details>
  </div>
</div></section>
</Article>
