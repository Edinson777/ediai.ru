---
/**
 * Главная EDIAI — редизайн по прототипу ediai_editorial_bento_v3.html.
 * Шапка/футер/секции прототипа переносятся дословно; все якорные ссылки-заглушки
 * заменены живыми адресами; промпт-полоса берёт запрос из data.json (p135).
 * Вёрстка — chrome={false}: своя шапка и футер, CSS — home.css (после style.css).
 */
import Base from '../layouts/Base.astro';
import { SITE_URL, SITE_NAME, WEBSITE_LD, TOTAL } from '../lib/site.js';
import { ld } from '../lib/gen.js';
import homeCss from '../styles/home.css?raw';

import dataJson from '../vendor/data.json';
const band = dataJson.prompts.find(p => p.id === 'p135');
const bandLink = '/prompty/zhizn/?q=' + encodeURIComponent(band.title);

const title = 'EDIAI — разумнее с деньгами. Увереннее с технологиями.';
const desc = 'EDIAI — практический портал о финансах, искусственном интеллекте и цифровой жизни. Понятные материалы, инструменты и готовые сценарии: накопления, ИИС-3 и ПДС, нейросети в работе и быту, безопасность в интернете.';

const ldGraphObj = { '@context': 'https://schema.org', '@graph': [
  { ...WEBSITE_LD, potentialAction: { '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: SITE_URL + '/poisk/?q={search_term_string}' },
    'query-input': 'required name=search_term_string' } },
  { '@type': 'WebPage', '@id': SITE_URL + '/', url: SITE_URL + '/',
    name: title, description: desc, inLanguage: 'ru',
    isPartOf: { '@id': SITE_URL + '/#website' } },
] };
---

<Base title={title} desc={desc} path="/" ogImg="og/og-index.png" ldGraph={ld(ldGraphObj)}
      chrome={false} baseCss={false} themeColor="#f3f0e8" extraCss={homeCss}>
<header><div class="wrap header-inner">
 <a class="brand" href="/" aria-label="EDIAI — на главную"><span class="brand-symbol">E.</span><span><span class="brand-word">EDIAI</span><span class="brand-sub">разумнее с деньгами · увереннее с технологиями</span></span></a>
 <nav aria-label="Главное меню"><a href="/finansy/">Финансы</a><a href="/prompty/">Искусственный интеллект</a><a href="/digital/">Цифровая жизнь</a><a href="/instrumenty/">Инструменты</a></nav>
 <div class="header-right"><button class="icon-btn" id="openSearch" aria-label="Открыть поиск">⌕</button><a class="header-cta" href="/guides/s-chego-nachat/">Найти полезное ↗</a><button class="icon-btn menu-btn" id="menuBtn" aria-label="Открыть меню">☰</button></div>
 </div><div class="wrap mobile-nav" id="mobileNav"><a href="/finansy/">Финансы</a><a href="/prompty/">Искусственный интеллект</a><a href="/digital/">Цифровая жизнь</a><a href="/instrumenty/">Инструменты</a><a href="/guides/">Материалы</a></div></header>
<main>
<section class="hero"><div class="wrap"><div class="hero-topline"><div class="eyebrow"><span class="dot"></span>Практический журнал для современной жизни</div><div class="issue">Деньги · Интеллект · Возможности / 2026</div></div>
 <div class="hero-grid"><div class="hero-copy"><h1>Разумнее<br>с деньгами.<br><span class="serif">Увереннее</span><br>с технологиями.</h1><p class="hero-lead">Понятно разбираемся в финансах, осваиваем искусственный интеллект и используем новые возможности в повседневной жизни.</p><div class="hero-actions"><a class="btn btn-dark" href="/finansy/">Исследовать финансы <span>↗</span></a><a class="btn btn-plain" href="/prompty/">Открыть мир ИИ <span>↗</span></a></div></div>
 <div class="hero-art" aria-label="Графическая композиция EDIAI"><div class="art-label">Две стороны одной жизни</div><div class="art-big">EDI<br>AI<span style="color:var(--orange)">.</span></div><div class="art-stamp">ЗНАНИЯ<br>В ДЕЙСТВИЕ</div><div class="art-bottom"><span class="art-chip">01 / Финансы</span><span class="art-chip">02 / ИИ</span></div><div class="art-index">Навигатор · 2026</div></div></div>
 <div class="ticker"><div class="ticker-inner"><span>Понятно о сложном</span><span>—</span><span>Практические инструкции</span><span>—</span><span>Полезные инструменты</span><span>—</span><span>Без лишнего шума</span></div></div>
</div></section>
<section class="section" id="start"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Два главных направления</div><h2>Выберите свою тему</h2><p>Два равноправных мира, которые помогают принимать более осознанные решения каждый день.</p></div><a class="text-link" href="/guides/">Смотреть все материалы ↗</a></div>
 <div class="dual-grid"><a class="track finance" id="finance" href="/finansy/"><div class="track-top"><span class="track-num">01 / 02</span><span class="track-type">Деньги и будущее</span></div><h3>Финансы.<br>Спокойствие начинается с ясности.</h3><p>ИИС-3, ПДС, подушка безопасности, вклады и налоги — объясняем условия, сравниваем варианты и показываем, на что обратить внимание.</p><div class="track-link">ИЗУЧИТЬ ФИНАНСЫ ↗</div><div class="finance-graphic"><div class="ring"></div><div class="ring ring2"></div><div class="coin">₽</div></div></a>
 <a class="track ai" id="ai" href="/prompty/"><div class="track-top"><span class="track-num">02 / 02</span><span class="track-type">Интеллект и технологии</span></div><h3>Искусственный интеллект.<br>В помощь человеку.</h3><p>Готовые запросы для нейросетей, честные сравнения моделей и кейсы с цифрами: {TOTAL} проверенных сценариев для работы, быта и денег.</p><div class="track-link" style="color:var(--lav)">ОТКРЫТЬ МИР ИИ ↗</div><div class="ai-graphic"><div class="ai-line"></div><div class="ai-orb"></div></div></a></div>
</div></section>
<section class="section" id="digital" style="padding-top:8px"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Ещё одно важное направление</div><h2>Цифровая жизнь — без лишней сложности</h2><p>Понятные инструкции для тех, кто хочет чувствовать себя увереннее в интернете и современных сервисах.</p></div></div>
 <div class="quick-grid"><a class="quick" href="/digital/"><div class="quick-ico">⌘</div><h3>Компьютер и смартфон</h3><p>Настройки, файлы, приложения и повседневные задачи.</p></a><a class="quick" href="/digital/"><div class="quick-ico">◎</div><h3>Интернет и сервисы</h3><p>Госуслуги, электронная почта и полезные сайты.</p></a><a class="quick" href="/digital/podozritelnoe-soobshchenie/"><div class="quick-ico">◇</div><h3>Безопасность</h3><p>Защита данных, пароли и распознавание обмана.</p></a><a class="quick" href="/instrumenty/"><div class="quick-ico">▤</div><h3>Инструменты</h3><p>Калькуляторы, шаблоны и помощники для жизни.</p></a></div>
</div></section>
<section class="section" id="articles"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Редакционный выбор</div><h2>Полезное — по делу</h2><p>Начните с понятных руководств и переходите к более сложным темам в удобном темпе.</p></div><a class="text-link" href="/guides/">Все публикации ↗</a></div>
 <div class="feature-grid"><article class="feature-main"><div class="eyebrow"><span class="dot"></span>Финансы / Большой гид</div><div class="paper-object"><div class="paper-line"></div><div class="paper-line short"></div><div class="paper-line"></div><div class="paper-circle">₽</div></div><div class="feature-text"><h3>ИИС-3: как разобраться в условиях и налоговых льготах</h3><p>Понятное руководство: что проверить перед открытием счёта, как устроены вычеты и какие ограничения важно учитывать.</p><a class="text-link" href="/finansy/iis-3-nalogovye-lgoty/">Читать руководство ↗</a></div></article>
 <div class="feature-side"><article class="side-story ai-story"><div class="story-top"><span>ИИ / Для начинающих</span><span>01</span></div><h3>Первая неделя с ИИ: без сложных слов</h3><p>Путеводитель новичка: как начать разговор с нейросетью и получать полезные ответы.</p><a href="/guides/s-chego-nachat/" style="color:var(--lav)">ОТКРЫТЬ МАТЕРИАЛ ↗</a></article><article class="side-story digital-story"><div class="story-top"><span>Цифровая жизнь</span><span>02</span></div><h3>Как распознать подозрительное сообщение</h3><p>Простые правила цифровой безопасности на каждый день.</p><a href="/digital/podozritelnoe-soobshchenie/" style="color:#a36345">ОТКРЫТЬ МАТЕРИАЛ ↗</a></article></div></div>
</div></section>
<section class="section" id="tools" style="padding-top:15px"><div class="wrap"><div class="tools-section"><div class="section-head"><div><div class="eyebrow">Bento / Практика</div><h2 style="color:#fff">Не только читать.<br>Пробовать и применять.</h2><p>Полезные инструменты EDIAI — от расчёта накоплений до готовых сценариев для ИИ.</p></div></div><div class="tools-grid"><a class="tool-card calc" href="#calculator"><div class="tag">01 / Финансовый инструмент</div><h3>Калькулятор<br>накоплений</h3><p>Оцените результат регулярных пополнений с учётом условной доходности.</p><span class="action">РАССЧИТАТЬ ↗</span></a><a class="tool-card prompt" href="/prompty/"><div class="tag">02 / ИИ-помощник</div><h3>Готовые запросы<br>для нейросетей</h3><p>Берите за основу готовые формулировки и адаптируйте под свою задачу.</p><span class="action">ПОПРОБОВАТЬ ↗</span></a><a class="tool-card budget" href="#prompt"><div class="tag">03 / Планирование</div><h3>Личный<br>бюджет</h3><p>Соберите простую структуру доходов, расходов и целей.</p><span class="action">ПЕРЕЙТИ ↗</span></a></div></div></div></section>
<section class="section" id="calculator"><div class="wrap calc-section"><div class="calc-intro"><div class="eyebrow">Инструмент EDIAI / 01</div><h2>Небольшие шаги.<br><span style="font-family:Georgia,serif;font-style:italic;color:var(--orange);font-weight:400">Большая цель.</span></h2><p>Посмотрите, как регулярные пополнения могут повлиять на итоговую сумму. Меняйте параметры и сравнивайте сценарии.</p></div>
 <div class="calc-panel"><div class="calc-fields"><div class="field"><label for="initial">Начальная сумма, ₽</label><input id="initial" type="number" min="0" step="1000" value="100000"></div><div class="field"><label for="monthly">Пополнение в месяц, ₽</label><input id="monthly" type="number" min="0" step="500" value="10000"></div><div class="field"><label for="rate">Условная доходность, % годовых</label><input id="rate" type="number" min="0" max="100" step=".1" value="7"></div><div class="field"><label for="years">Срок, лет</label><input id="years" type="number" min="1" max="50" step="1" value="10"></div></div><div class="calc-result"><div><span>Расчётная сумма</span><br><strong id="total">—</strong></div><div><span id="paid">Всего внесено: —</span><br><span id="growth">Разница: —</span></div></div><div class="calc-note">Демонстрационный расчёт с ежемесячной капитализацией и пополнением в конце месяца. Доходность не гарантирована; налоги, комиссии и инфляция не учитываются. Не является инвестиционной рекомендацией.</div></div>
</div></section>
<section class="section" id="prompt"><div class="wrap"><div class="prompt-band"><div><div class="eyebrow">ИИ в реальной жизни</div><h2>Начните с одного хорошего вопроса.</h2><p>Не нужно знать специальные команды. Опишите задачу обычными словами — и уточняйте ответ по ходу.</p><a class="text-link" href={bandLink}>Больше готовых запросов ↗</a></div><div class="prompt-copy"><blockquote id="promptText">{band.prompt}</blockquote><div class="prompt-controls"><button class="copy-btn" id="copyPrompt">Скопировать запрос ↗</button><span class="prompt-hint">Не вводите пароли, данные карт и другую конфиденциальную информацию.</span></div></div></div></div></section>
<section class="newsletter"><div class="wrap newsletter-inner"><div><h2>Полезное — без информационного шума.</h2><p>Новые материалы и инструменты EDIAI — в RSS-ленте; канал в мессенджере появится отдельно.</p></div><a class="btn btn-dark" href="/rss.xml">Подписка на RSS ↗</a></div></section>
</main>
<footer><div class="wrap"><div class="footer-top"><div class="footer-brand"><a class="brand" href="/"><span class="brand-symbol">E.</span><span><span class="brand-word">EDIAI</span><span class="brand-sub">разумнее с деньгами · увереннее с технологиями</span></span></a><p>Практический портал о финансах, искусственном интеллекте и цифровой жизни. Понятно о сложном — полезно в повседневных решениях.</p></div><div><h4>Направления</h4><div class="footer-links"><a href="/finansy/">Финансы</a><a href="/prompty/">Искусственный интеллект</a><a href="/digital/">Цифровая жизнь</a><a href="/instrumenty/">Инструменты</a></div></div><div><h4>EDIAI</h4><div class="footer-links"><a href="/guides/s-chego-nachat/">С чего начать</a><a href="/guides/">Материалы</a><a href="/glossary/">Глоссарий</a><a href="/o-proekte/">О проекте</a><a href="/poisk/">Поиск</a><a href="mailto:hello@ediai.ru">Контакты</a></div></div></div><div class="footer-bottom"><span>© {SITE_NAME} · ediai.ru</span><span>Материалы о финансах носят информационный характер и не являются инвестиционной рекомендацией.</span></div></div></footer>
<div class="search-modal" id="searchModal" role="dialog" aria-modal="true" aria-label="Поиск по EDIAI"><div class="search-box"><form action="/poisk/" method="get" role="search"><div class="search-head"><strong>Что хотите найти?</strong><button class="icon-btn" type="button" id="closeSearch" aria-label="Закрыть поиск">×</button></div><input type="search" id="searchInput" name="q" placeholder="Например: ИИС-3, ПДС, нейросеть…"><div class="search-results" id="searchResults"><a href="/finansy/iis-3-nalogovye-lgoty/">ИИС-3: налоговые льготы и сроки ↗</a><a href="/finansy/pds-vklad-nakopitelnyj-schet/">ПДС: программа долгосрочных сбережений ↗</a><a href="/finansy/podushka-bezopasnosti/">Подушка безопасности: сколько и где держать ↗</a><a href="/digital/podozritelnoe-soobshchenie/">Как распознать подозрительное сообщение ↗</a><a href="/guides/s-chego-nachat/">ChatGPT для начинающих: первые шаги ↗</a><a href="#calculator">Калькулятор накоплений ↗</a><a href="/prompty/">Готовые запросы для нейросетей ↗</a></div></form></div></div><div class="toast" id="toast">Запрос скопирован</div>
<script is:inline>
const $=s=>document.querySelector(s);
const menu=$('#mobileNav');$('#menuBtn').addEventListener('click',()=>menu.classList.toggle('open'));menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>menu.classList.remove('open')));
function rub(n){return new Intl.NumberFormat('ru-RU',{maximumFractionDigits:0}).format(Math.round(n))+' ₽'}function calc(){const initial=Math.max(0,Number($('#initial').value)||0),monthly=Math.max(0,Number($('#monthly').value)||0),rate=Math.min(100,Math.max(0,Number($('#rate').value)||0))/1200,years=Math.min(50,Math.max(1,Number($('#years').value)||1)),months=years*12;let total=initial;for(let i=0;i<months;i++)total=total*(1+rate)+monthly;const paid=initial+monthly*months;$('#total').textContent=rub(total);$('#paid').textContent='Всего внесено: '+rub(paid);$('#growth').textContent='Разница: '+rub(total-paid)}['initial','monthly','rate','years'].forEach(id=>$('#'+id).addEventListener('input',calc));calc();
$('#copyPrompt').addEventListener('click',async()=>{const txt=$('#promptText').textContent;try{await navigator.clipboard.writeText(txt)}catch(e){const t=document.createElement('textarea');t.value=txt;document.body.appendChild(t);t.select();document.execCommand('copy');t.remove()}const toast=$('#toast');toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2000)});
const modal=$('#searchModal'),input=$('#searchInput'),results=$('#searchResults');
$('#openSearch').addEventListener('click',()=>{modal.classList.add('open');input.focus()});$('#closeSearch').addEventListener('click',()=>modal.classList.remove('open'));modal.addEventListener('click',e=>{if(e.target===modal)modal.classList.remove('open')});document.addEventListener('keydown',e=>{if(e.key==='Escape')modal.classList.remove('open')});
const sLinks=[...results.querySelectorAll('a')];
input.addEventListener('input',()=>{const q=input.value.trim().toLocaleLowerCase('ru');let shown=0;sLinks.forEach(a=>{const hit=!q||a.textContent.toLocaleLowerCase('ru').includes(q);a.style.display=hit?'':'none';if(hit)shown++});if(q&&!shown){if(!results.querySelector('.no-hint')){const s=document.createElement('span');s.className='no-hint';s.style.cssText='font-size:12px;color:var(--muted)';s.textContent='Прямых подсказок нет — нажмите Enter, и поиск по всему сайту выполнится автоматически.';results.appendChild(s)}}else{const h=results.querySelector('.no-hint');if(h)h.remove()}});
</script>
</Base>
