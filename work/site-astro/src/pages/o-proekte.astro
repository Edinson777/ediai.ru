---
/** Вспомогательная страница /o-proekte/ (стратегия §5.3: автор, зачем база,
 *  методика проверки промптов; площадка разметки Person — сигнал E-E-A-T).
 *  Фаза 2, крошки + BreadcrumbList. Имя автора не публикуем — разметка Organization. */
import Base from '../layouts/Base.astro';
import { D, SITE_URL, TOTAL, UPDATED, WEBSITE_LD, breadcrumbLd, crumbs } from '../lib/site.js';
import { ld } from '../lib/gen.js';

const path = '/o-proekte/';
const crumb = crumbs([
  { name: 'Главная', href: '/' },
  { name: 'О проекте' },
]);
const ldGraphObj = { '@context': 'https://schema.org', '@graph': [
  WEBSITE_LD,
  breadcrumbLd(crumb),
  { '@type': 'WebPage', '@id': SITE_URL + path, url: SITE_URL + path,
    name: 'О проекте Ediai: зачем база промптов и как она проверяется',
    description: 'Кто и зачем делает Ediai: ' + TOTAL + ' практических промптов для нейросетей на русском языке, методика проверки и принципы проекта.',
    inLanguage: 'ru', isPartOf: { '@id': SITE_URL + '/#website' },
    about: { '@type': 'Organization', name: 'Ediai', url: SITE_URL + '/' } },
] };
---

<Base title={'О проекте Ediai: зачем база промптов и как она проверяется'}
      desc={'Ediai — практическая база из ' + TOTAL + ' промптов для нейросетей на русском языке. Зачем проект, как составляются и проверяются промпты, принципы и планы.'}
      path={path} ogImg="og/og-index.png" ldGraph={ld(ldGraphObj)} crumb={crumb}>
  <a class="skip-link" href="#main">Перейти к содержимому</a>
  <main class="wrap" id="main" tabindex="-1">
    <section class="hero">
      <h1>О проекте</h1>
      <p class="hub-sub">Ediai.ru — практическая база из {TOTAL} промптов и сценариев для нейросетей на русском языке: переделка фото, генерация изображений, тексты, личная жизнь, работа и модели Qwen.</p>
      <p class="hub-meta">Обновлено {UPDATED} · Редакция Ediai</p>
    </section>
    <div class="strip">
      <h2>Зачем нужна база</h2>
      <p>Большинство руководств по промптам написаны под английский, переведены дословно и проверены автором через силу. Ediai — обратный подход: каждый сценарий рождается из реальной задачи (переделать фото для аватара, составить отчёт за неделю, собрать меню из того, что есть в холодильнике), пишется по-русски сразу и проверяется в бесплатных моделях, доступных обычному пользователю.</p>
      <p>Проект живёт по принципу «владелец + ИИ»: материалы готовятся в паре с нейросетями, но каждый промпт и каждый вывод проходят ручную проверку человеком. Автоматической генерации страниц «ради объёма» в базе нет и не будет.</p>
      <h2>Методика проверки промптов</h2>
      <ul>
        <li><b>Задача сначала.</b> Промпт попадает в базу, только если решает конкретную повторяемую задачу, а не «демонстрирует возможности модели».</li>
        <li><b>Проверка в 2–3 моделях.</b> Сценарий тестируется минимум в двух нейросетях (например, ChatGPT и Qwen); особенности совместимости помечены пилюлями «Qwen ✓», «DeepSeek ✓» и подписями-подсказками.</li>
        <li><b>Русский язык.</b> Все промпты написаны на русском; модели-исключения (например, Midjourney) снабжены английскими версиями и пояснениями параметров.</li>
        <li><b>Плейсхолдеры вместо догадок.</b> Переменные части выделены <span style="color:var(--ph);font-weight:600">[скобками]</span> — вы подставляете свои данные, модель не фантазирует.</li>
        <li><b>Дата обновления.</b> Тарифы и возможности моделей меняются; на каждом материале стоит дата проверки, устаревшее пересматривается.</li>
      </ul>
      <h2>Принципы</h2>
      <ul>
        <li>Без регистрации и оплаты: все промпты — открытый текст.</li>
        <li>Этика по умолчанию: переделка только своих фото или с явным согласием, никаких дипфейков реальных людей, обезличивание данных перед отправкой в чат-боты.</li>
        <li>Честность цифр: расчёты и кейсы помечены как иллюстративные, источники — по ссылкам.</li>
      </ul>
      <h2>Контакты и предложения</h2>
      <p>Нашли ошибку в промпте или хотите предложить сценарий — напишите в раздел предложений через форму обратной связи (появится вместе со страницей контактов) или проверьте обновления базы: новые промпты выходят 2–3 раза в неделю, план развития — в <a href="/guides/s-chego-nachat/" style="color:#244b3d">путеводителе</a> и <a href="/guides/ii-i-pochta/" style="color:#244b3d">кейсах</a>.</p>
    </div>
  </main>
  <footer>
    <div class="wrap">
      <b>⚡ Ediai — ИИ в личной жизни и работе</b> · {TOTAL} проверенных сценариев и промптов: изображения, тексты, редактирование фото, гиды и сравнения.
    </div>
      <div class="svc-nav"><a href="/o-proekte/">О проекте</a> · <a href="/politika-konfidencialnosti/">Политика конфиденциальности</a> · <a href="/poisk/">Поиск</a></div>
  </footer>
</Base>
