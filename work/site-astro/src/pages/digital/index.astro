---
/** Хаб «Цифровая жизнь» — новый слой редизайна (этап 1).
 *  Старт: материал по безопасности + мосты к готовым гайдам ИИ-крыла. */
import Article from '../../layouts/Article.astro';
import { SITE_URL } from '../../lib/site.js';
import { ld } from '../../lib/gen.js';

const title = 'Цифровая жизнь — понятные инструкции без лишней сложности | EDIAI';
const desc = 'Как чувствовать себя увереннее в интернете и сервисах: безопасность и защита от мошенников, компьютер и смартфон, Госуслуги и почта. Простыми словами, с чек-листами.';

const crumb = [
  { name: 'Главная', href: '/' },
  { name: 'Цифровая жизнь' },
];

const ldGraphObj = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: crumb.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name,
      ...(c.href ? { item: SITE_URL + c.href } : {}) })) },
  { '@type': 'CollectionPage', '@id': SITE_URL + '/digital/', url: SITE_URL + '/digital/',
    name: 'Цифровая жизнь', description: desc, inLanguage: 'ru',
    isPartOf: { '@id': SITE_URL + '/#website' } },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'О чём раздел «Цифровая жизнь»?',
      acceptedAnswer: { '@type': 'Answer', text: 'О практических навыках повседневной цифровой жизни: как защитить себя от мошенников, навести порядок в смартфоне и компьютере, пользоваться госсервисами и почтой — без жаргона и с чек-листами.' } },
    { '@type': 'Question', name: 'Раздел только про безопасность?',
      acceptedAnswer: { '@type': 'Answer', text: 'Нет. Безопасность — первая тема, потому что она самая востребованная. Далее раздел наполнится материалами про компьютер и смартфон, интернет-сервисы и полезные инструменты.' } },
  ] },
] };
---

<Article title={title} desc={desc} path="/digital/" ogImg="og/og-digital.png"
          ldGraph={ld(ldGraphObj)} hero="digital"
          eyebrow="Направление EDIAI / 03 · Технологии в быту"
          crumb={crumb}>
<Fragment slot="hero">
  <h1>Цифровая жизнь — без лишней сложности</h1>
  <p class="nh-lead">Понятные инструкции для тех, кто хочет чувствовать себя увереннее в интернете и современных сервисах: безопасность, смартфон и компьютер, госсервисы, почта.</p>
</Fragment>

<section class="e-section" style="padding-top:0"><div class="e-wrap">
  <div class="e-eyebrow"><span class="e-dot"></span>Начните с самого важного</div>
  <h2 class="e-h2">Безопасность — первая тема</h2>
  <p class="e-sub">Мошенничество — самый частый источник цифровых потерь. Освоить пару простых правил дешевле, чем терять деньги.</p>
  <div class="e-grid" style="margin-top:20px">
    <a class="e-card" href="/digital/podozritelnoe-soobshchenie/"><span class="tag">Материал · Безопасность</span><h3>Как распознать подозрительное сообщение</h3><p>Три признака обмана, правило одной минуты и план действий, если уже нажали.</p><span class="go">ЧИТАТЬ ↗</span></a>
    <a class="e-card lav" href="/guides/s-chego-nachat/"><span class="tag">Из ИИ-направления</span><h3>Первая неделя с ИИ</h3><p>Путеводитель для новичка: как разговаривать с нейросетью и получать полезные ответы.</p><span class="go">ЧИТАТЬ ↗</span></a>
    <a class="e-card lav" href="/glossary/"><span class="tag">Справка</span><h3>Глоссарий терминов</h3><p>16 терминов простыми словами: от «промпта» до «нейросети» — без сложных определений.</p><span class="go">ОТКРЫТЬ ↗</span></a>
  </div>
</div></section>

<section class="e-section" style="padding-top:0"><div class="e-wrap">
  <div class="e-eyebrow">Направления внутри</div>
  <h2 class="e-h2">Что будет в разделе</h2>
  <p class="e-sub">Материалы выходят по мере готовности; очередь — по реальным вопросам читателей.</p>
  <div class="e-grid" style="margin-top:20px">
    <div class="e-card soon"><span class="tag">Готовится</span><h3>Компьютер и смартфон</h3><p>Настройки, файлы, приложения и повседневные задачи: десять проверок для спокойствия.</p><span class="go">СКОРО</span></div>
    <div class="e-card soon"><span class="tag">Готовится</span><h3>Интернет и сервисы</h3><p>Госуслуги: что включить в настройках. Электронная почта: порядок и безопасность.</p><span class="go">СКОРО</span></div>
    <div class="e-card soon"><span class="tag">Готовится</span><h3>Пароли и менеджер паролей</h3><p>Минимум действий для того, чтобы один утёкший пароль не потянул за собой остальные.</p><span class="go">СКОРО</span></div>
  </div>
</div></section>

<section class="e-section" style="padding-top:0"><div class="e-wrap">
  <div class="e-eyebrow">Частые вопросы</div>
  <h2 class="e-h2">Коротко о разделе</h2>
  <div class="e-faq">
    <details><summary>О чём этот раздел?</summary><p>О практических навыках повседневной цифровой жизни: защита от мошенников, порядок в смартфоне и компьютере, госсервисы и почта — простыми словами и с чек-листами.</p></details>
    <details><summary>Раздел только про безопасность?</summary><p>Нет: безопасность — первая и самая востребованная тема, дальше раздел наполнится материалами про технику и сервисы.</p></details>
  </div>
</div></section>
</Article>
