---
/** Материал «Как распознать подозрительное сообщение» — цифровая безопасность. */
import Article from '../../../layouts/Article.astro';
import { SITE_URL } from '../../../lib/site.js';
import { ld } from '../../../lib/gen.js';

const title = 'Как распознать подозрительное сообщение: простые правила | EDIAI';
const desc = 'Признаки мошеннического сообщения: спешка, деньги, переход по ссылке. Что делать, если уже нажали, и как защитить близких. Чек-лист цифровой безопасности на каждый день.';

const crumb = [
  { name: 'Главная', href: '/' },
  { name: 'Цифровая жизнь', href: '/digital/' },
  { name: 'Подозрительное сообщение' },
];

const ldGraphObj = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: crumb.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name,
      ...(c.href ? { item: SITE_URL + c.href } : {}) })) },
  { '@type': 'Article', '@id': SITE_URL + '/digital/podozritelnoe-soobshchenie/#article',
    headline: 'Как распознать подозрительное сообщение: простые правила',
    description: desc, inLanguage: 'ru', datePublished: '2026-11-21',
    author: { '@type': 'Organization', name: 'EDIAI', url: SITE_URL + '/' },
    isPartOf: { '@id': SITE_URL + '/#website' } },
  { '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'Какие признаки выдают мошенническое сообщение?',
      acceptedAnswer: { '@type': 'Answer', text: 'Три главных: спешка («сейчас или заблокируем»), разговор о деньгах или кодах из СМС, и просьба перейти по ссылке или установить приложение. Настоящие банки не спрашивают пароли, коды и CVV — ни в чате, ни по телефону.' } },
    { '@type': 'Question', name: 'Что делать, если уже перешёл по ссылке и ввёл данные?',
      acceptedAnswer: { '@type': 'Answer', text: 'Немедленно: позвонить в банк по номеру с карты или официального сайта и заблокировать операции, сменить пароли (сначала — в банке и почте), проверить устройство антивирусом. Если ушла крупная сумма — обратиться в полицию, сохраняя скриншоты переписки.' } },
    { '@type': 'Question', name: 'Как защитить пожилых родственников?',
      acceptedAnswer: { '@type': 'Answer', text: 'Договоритесь о «кодовом слове семьи» и правиле: любые просьбы о деньгах — сначала звонок по обычному телефону известному номеру. Установите на их смартфоны обновления и упростите им связь с вами: ярлык «Позвонить детям» на первом экране.' } },
  ] },
] };
---

<Article title={title} desc={desc} path="/digital/podozritelnoe-soobshchenie/" ogImg="og/og-digital.png"
          ldGraph={ld(ldGraphObj)} hero="material"
          eyebrow="Цифровая жизнь / Безопасность"
          badge="Цифровая жизнь" badgeClass="lav" dateLabel="21 ноября 2026" readTime="≈ 6 минут"
          crumb={crumb}>
<Fragment slot="hero">
  <h1>Как распознать подозрительное сообщение</h1>
  <p class="nh-lead">Мошенничество почти всегда строится по одному сценарию: спешка + страх + деньги. Достаточно выучить три признака и пару правил — и 9 из 10 попыток обмана отпадут сами.</p>
</Fragment>

<div class="prose">
  <p>Подозрительное сообщение — это любая неожиданная попытка заставить вас <strong>сейчас</strong> сделать что-то с деньгами, кодами или ссылками. Неважно, пришло оно в СМС, мессенджер, на почту или по телефону от «службы безопасности банка» — механика одна и та же.</p>

  <h2>Три главных признака</h2>
  <ul class="check-list">
    <li><strong>Спешка.</strong> «Карта будет заблокирована через час», «срок действия кода истекает». Настоящие организации не решают ваши вопросы за один всплеск адреналина.</li>
    <li><strong>Разговор о деньгах или кодах.</strong> Просят перевести деньги на «безопасный счёт», продиктовать код из СМС, назвать пароль или CVV с обратной стороны карты. Банк никогда не спрашивает коды — ни в чате, ни по телефону.</li>
    <li><strong>Ссылка или приложение.</strong> «Перейдите и подтвердите вход», «установите приложение поддержки». Ссылки ведут на сайты-двойники, приложения — на перехват СМС.</li>
  </ul>
  <p>Дополнительные маркеры: незнакомый адрес отправителя с «чужим» именем, ошибки в словах, анонимные номера, единый для всех текст без вашего имени и деталей. А ещё — любое <strong>внезапное сообщение от знакомого</strong> с просьбой срочно занять деньги: аккаунт могли взломать.</p>

  <div class="e-note"><b>Правило одной минуты.</b> Любая срочная просьба о деньгах или данных — стоп на одну минуту: перезвоните сами по номеру с официального сайта или с обратной стороны карты, напишите человеку привычным способом. Мошенник не выдерживает паузы — она разрушает весь его сценарий.</div>

  <h2>Что делать, если подозрение подтвердилось</h2>
  <ol>
    <li>Не отвечайте, ничего не нажимайте, приложение из сообщения не устанавливайте.</li>
    <li>Проверьте версию официально: приложение банка, номер с карты, личный кабинет на официальном сайте.</li>
    <li>Перешлите сообщение туда, где его разберут: у банков есть отдельные адреса для жалоб на фишинг, а у сотовых операторов — короткие номера для пересылки спама.</li>
    <li>Если чувствуете, что «схема прицельная» — предупредите семью: часто рядом с одной жертвой проверяют и остальных.</li>
  </ol>

  <h2>Если уже нажали и ввели данные</h2>
  <ol>
    <li><strong>Звонок в банк немедленно</strong> — заблокировать операции и перевыпустить карту (номер — на карте или официальном сайте).</li>
    <li><strong>Смена паролей</strong> — сначала в банке, затем в почте (почта — ключ ко всем аккаунтам), затем в остальных сервисах.</li>
    <li><strong>Проверка устройства</strong> антивирусом; если устанавливали приложение из сообщения — считать телефон скомпрометированным и не вводить на нём ничего важного до проверки.</li>
    <li><strong>Если ушла крупная сумма</strong> — заявление в полицию, скриншоты переписки и чеков сохраните.</li>
  </ol>

  <h2>Чек-лист на каждый день</h2>
  <ul class="check-list">
    <li>Разные пароли для важных сервисов; менеджер паролей вместо блокнота.</li>
    <li>Двухфакторный вход везде, где есть деньги — но не по СМС-коду в ответ на чью-то просьбу.</li>
    <li>Обновления системы и приложений не откладывать — закрывают известные дыры.</li>
    <li>Кодовое слово семьи и правило «про деньги — сначала звонок».</li>
    <li>Настройки приватности мессенджеров: не публиковать номер телефона в открытую.</li>
  </ul>

  <h2>Частые вопросы</h2>
  <div class="e-faq">
    <details><summary>Какие признаки выдают обман?</summary><p>Спешка, разговор о деньгах или кодах, просьба перейти по ссылке или поставить приложение. Настоящие банки не спрашивают пароли и коды.</p></details>
    <details><summary>Уже перешёл по ссылке и ввёл данные — что делать?</summary><p>Сразу звонок в банк на блокировку, смена паролей (банк → почта → остальное), проверка устройства антивирусом; при крупной сумме — полиция со скриншотами.</p></details>
    <details><summary>Как защитить пожилых родственников?</summary><p>Кодовое слово семьи, правило «про деньги — сначала звонок», обновления на смартфоне и быстрый ярлык связи с вами на первом экране.</p></details>
  </div>

  <div class="e-disc">Материал носит информационный характер. Актуальные рекомендации по цифровой безопасности публикуют, в частности, портал Банка России и проект «Финансовая культура» (<a href="https://fincult.info/" rel="nofollow noopener" target="_blank">fincult.info</a>) — при подозрении на мошенничество сверяйтесь с официальными источниками.</div>
</div>

