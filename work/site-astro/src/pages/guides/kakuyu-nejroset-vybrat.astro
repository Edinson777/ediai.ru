---
/** Гайд «Какая нейросеть для чего» (порт know_models() + build_models() из build.py).
 *  Фаза 2: адрес /guides/kakuyu-nejroset-vybrat/, крошки + BreadcrumbList, абсолютные ссылки. */
import KnowPage from '../../templates/KnowPage.astro';
import { D, SITE_URL, WEBSITE_LD, UPDATED, breadcrumbLd, crumbs } from '../../lib/site.js';
import { ld } from '../../lib/gen.js';

const path = '/guides/kakuyu-nejroset-vybrat/';
const crumb = crumbs([
  { name: 'Главная', href: '/' },
  { name: 'Гайды', href: '/guides/' },
  { name: 'Какую нейросеть выбрать' },
]);
const ldGraphObj = { '@context': 'https://schema.org', '@graph': [
  WEBSITE_LD,
  breadcrumbLd(crumb),
  { '@type': 'WebPage', '@id': SITE_URL + path, url: SITE_URL + path,
    name: 'Какая нейросеть для чего: сравнение задач и моделей', description: D.MODELS_DESC,
    inLanguage: 'ru', isPartOf: { '@id': SITE_URL + '/#website' } },
  { '@type': 'FAQPage', mainEntity: D.MODELS_FAQ.map(([q, a]) => ({ '@type': 'Question',
    name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
] };
---

<KnowPage path={path} title={D.MODELS_TITLE} desc={D.MODELS_DESC} ogimg="og/og-models.png" ldGraph={ld(ldGraphObj)} navcur={path} crumb={crumb}>
  <section class="hero">
    <h1>Какая нейросеть для чего: сравнение задач и моделей</h1>
    <p class="hub-sub">Тексты, фотографии, изображения с нуля, код, анализ и строгий JSON — с бесплатными вариантами и заменами. Тарифы меняются: сверяйте даты обновлений.</p>
    <p class="hub-meta">Обновлено {UPDATED} · Бесплатные тарифы · Русский язык</p>
  </section>
  <div class="strip">
    <h2>Задача → модель</h2>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Таблица с горизонтальной прокруткой">
      <table class="cmp">
        <tr><th>Задача</th><th>Чем решать</th><th>Бесплатный вариант</th></tr>
        {D.MODELS_MINI.map(([task, models, free]) => (
          <tr><td set:html={task} /><td set:html={models} /><td set:html={free} /></tr>
        ))}
      </table>
    </div>
    <h2>Частые вопросы</h2>
    <div class="faq">
      {D.MODELS_FAQ.map(([q, a]) => (
        <details><summary>{q}</summary><p set:html={a} /></details>
      ))}
    </div>
    <p class="p-go"><a href="/glossary/">Глоссарий терминов →</a> · <a href="/guides/s-chego-nachat/">С чего начать →</a> · <a href="/instrumenty/">Обзор моделей →</a></p>
  </div>
</KnowPage>
