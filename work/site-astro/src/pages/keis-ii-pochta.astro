---
/** Порт know_case() + keis_content() из build.py: кейс «Сколько часов экономит ИИ». */
import KnowPage from '../templates/KnowPage.astro';
import { D, SITE_URL, WEBSITE_LD, LASTMOD, UPDATED } from '../lib/site.js';
import { ld, banner } from '../lib/gen.js';

const path = D.KEIS_FILE;
const url = SITE_URL + '/' + path;
const ldGraphObj = { '@context': 'https://schema.org', '@graph': [
  WEBSITE_LD,
  { '@type': 'WebPage', '@id': url, url: url,
    name: D.KEIS_H1, description: D.KEIS_DESC,
    inLanguage: 'ru', isPartOf: { '@id': SITE_URL + '/#website' } },
  { '@type': 'Article', '@id': url, url: url,
    headline: D.KEIS_H1 + ': цифры и 7 промптов',
    description: D.KEIS_DESC, inLanguage: 'ru',
    image: [SITE_URL + '/og/og-keis-pochta.png'],
    author: { '@type': 'Organization', name: 'Ediai', url: SITE_URL + '/' },
    publisher: { '@type': 'Organization', name: 'Ediai', url: SITE_URL + '/' },
    datePublished: LASTMOD, dateModified: LASTMOD,
    articleBody: D.KEIS_BODY_TEXT,
    keywords: 'ИИ на работе, письма, документы, экономия времени, промпты, кейс, exec-summary, протокол встречи',
    isPartOf: { '@id': SITE_URL + '/#website' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url } },
  { '@type': 'HowTo', name: 'Как повторить кейс «ИИ на письмах и документах»',
    step: D.KEIS_HOWTO.map((st, i) => ({ '@type': 'HowToStep', position: i + 1, name: st })) },
] };
const keisBanner = banner('work.html', '💼', '<b>«ИИ на работе»</b> — все 30 промптов раздела: письма и деликатные '
  + 'отказы, отчёты и exec-summary, встречи и переговоры, резюме, документы и планы.');
---

<KnowPage path={path} title={D.KEIS_TITLE} desc={D.KEIS_DESC} ogimg="og/og-keis-pochta.png" ldGraph={ld(ldGraphObj)} navcur={path} ogType="article">
  <section class="hero">
    <h1>{D.KEIS_H1}</h1>
    <p class="hub-sub">Кейс с цифрами: письма, отчёты и протоколы — самые частые рабочие задачи для нейросетей. Что показывают исследования 2025–2026 годов, как посчитать свою экономию и какие 7 промптов закрывают типовую рабочую неделю.</p>
    <p class="hub-meta">Обновлено {UPDATED} · ~6 минут чтения · Кейс редакции Ediai</p>
  </section>
  <div class="strip">
    <h2>Коротко</h2>
    <ul>
      <li>Письма и документы — задача №1 для ИИ на работе: <b>40–42% рабочих запросов</b> к ChatGPT — это тексты (OpenAI + NBER, 2025).</li>
      <li>Схема экономии простая: нейросеть собирает черновик за 1–2 минуты, вы тратите 3–5 минут на факты и тон — вместо 15–60 минут на документ с нуля.</li>
      <li>Ниже — иллюстративный расчёт рабочей недели и 7 готовых промптов из раздела <a href="work.html">«ИИ на работе»</a>.</li>
      <li>Навык окупается буквально: медианная зарплата специалистов с умением работать с ИИ — <b>+34%</b> (hh.ru).</li>
    </ul>
    <h2>Что говорят исследования</h2>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Таблица с горизонтальной прокруткой">
      <table class="cmp">
        <tr><th>Цифра</th><th>Что означает</th><th>Источник</th></tr>
        {D.KEIS_RESEARCH.map(([num, mean, src]) => (
          <tr><td set:html={num} /><td set:html={mean} /><td set:html={src} /></tr>
        ))}
      </table>
    </div>
    <h2>Пример расчёта: рабочая неделя писем и документов</h2>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Таблица с горизонтальной прокруткой">
      <table class="cmp">
        <tr><th>Задача</th><th>Без ИИ</th><th>С ИИ</th><th>Пояснение</th></tr>
        {D.KEIS_CALC.map(([task, wo, w_, note]) => (
          <tr><td set:html={task} /><td set:html={wo} /><td set:html={w_} /><td set:html={note} /></tr>
        ))}
      </table>
    </div>
    <p class="art-note">Расчёт иллюстративный, а не обещание: подставьте свои цифры. Принцип один — нейросеть забирает 70–80% механической сборки черновика, человек оставляет себе факты, суждения и ответственность. Если таких задач в неделе пять-семь, высвобождается от 3–4 часов — почти половина рабочего дня.</p>
    <h2>7 промптов на рабочую неделю</h2>
    <div class="guide">
      {D.KEIS_STEPS.map(([pid, day, t, txt], i) => (
        <div class="gstep" id={'keis-' + pid}>
          <span class="s-n">{i + 1}</span>
          <div>
            <h3>{day} · {t}</h3>
            <p set:html={txt} />
            <p class="p-go"><a href={'work.html#' + pid}>Открыть промпт в разделе →</a></p>
          </div>
        </div>
      ))}
    </div>
    <div class="info-strip warn-strip"><span class="ic" aria-hidden="true">🔒</span>
      <span><b>Прежде чем копировать:</b> не отправляйте в публичные чат-боты коммерческую тайну, персональные данные и финотчётность — обезличивайте: имена и компании → <code>[компания]</code>, суммы → диапазоны. ИИ галлюцинирует: цифры, даты, цитаты и юридические формулировки проверяйте по первоисточнику.</span></div>
    <h2>Как повторить этот кейс</h2>
    <ul>
      {D.KEIS_HOWTO.map((st, i) => (
        <li><b>{i + 1}.</b> <Fragment set:html={st} /></li>
      ))}
    </ul>
    <Fragment set:html={keisBanner} />
    <p class="art-next">Следующий кейс серии: <b>«Неделя ИИ-меню: что вышло»</b> — эксперимент с меню из того, что есть в холодильнике: цифры, выводы и промпты из раздела <a href="life.html">«ИИ в личной жизни»</a>.</p>
    <details class="sources"><summary><h2>📖 Источники кейса</h2>
      <span class="src-hint">показать список</span></summary>
      <div class="sources-in"><p class="note">Цифры — из опубликованных исследований по ссылкам ниже; таблица расчёта — иллюстративная модель редакции Ediai. Промпты — из раздела «ИИ на работе», составлены редакцией. Проверено: {UPDATED}.</p>
        <Fragment set:html={D.SRC.work_ul} />
      </div></details>
  </div>
</KnowPage>
